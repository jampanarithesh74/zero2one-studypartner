{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator of the platform",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Normalized subject-centric database record serving multiple departments",
      "type": "object",
      "properties": {
        "subjectCode": { "type": "string" },
        "subjectName": { "type": "string" },
        "semester": { "type": "number" },
        "linked_departments": { "type": "array" },
        "credits": { "type": "number" },
        "type": { "type": "string" },
        "lecture": { "type": "number" },
        "tutorial": { "type": "number" },
        "practical": { "type": "number" },
        "outcomes": { "type": "array" },
        "units": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectCode", "subjectName", "semester", "linked_departments"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Academic resource (notes or PYQs) referenced by subject code relation",
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "sem": { "type": "number" },
        "subjectCode": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "fileUrl": { "type": "string" },
        "driveLink": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" },
        "unit": { "type": "number" },
        "year": { "type": "number" },
        "department_visibility": { "type": "array" },
        "semester": { "type": "number" }
      },
      "required": ["subjectCode", "type", "title", "uploadedAt", "uploadedBy"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Global announcement displayed prominently to users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "imageUrl": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonUrl": { "type": "string" },
        "priority": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "type", "priority", "active", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Student user profile parsed from college email domain and onboarding wizard",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "batch": { "type": "string" },
        "departmentCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "section": { "type": "string" },
        "rollNumber": { "type": "string" },
        "selectedUserType": { "type": "string" },
        "effectiveAcademicYear": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "profileVersion": { "type": "number" },
        "lastOpenedRoute": { "type": "string" }
      },
      "required": ["uid", "email", "batch", "departmentCode", "departmentName", "section", "rollNumber", "selectedUserType", "effectiveAcademicYear", "onboardingCompleted", "profileVersion"]
    },
    "AcademicSettings": {
      "title": "AcademicSettings",
      "description": "Holds admin settings such as batch mapping configuration",
      "type": "object",
      "properties": {
        "batchYearMapping": { "type": "object" }
      },
      "required": ["batchYearMapping"]
    },
    "ActiveQuestion": {
      "title": "ActiveQuestion",
      "description": "Active real-time event question published by admin",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "isActive": { "type": "boolean" },
        "questionId": { "type": "string" }
      },
      "required": ["question", "createdBy", "isActive", "questionId"]
    },
    "LiveAnswer": {
      "title": "LiveAnswer",
      "description": "Participant response to active event question",
      "type": "object",
      "properties": {
        "participantId": { "type": "string" },
        "participantName": { "type": "string" },
        "answer": { "type": "string" },
        "submittedAt": { "type": "string" },
        "questionId": { "type": "string" }
      },
      "required": ["participantId", "participantName", "answer", "questionId"]
    }
  },
  "firestore": {
    "admins/{uid}": {
      "schema": "Admin",
      "description": "Platform administrators"
    },
    "users/{uid}": {
      "schema": "User",
      "description": "Durable college students profile"
    },
    "academic_settings/{settingId}": {
      "schema": "AcademicSettings",
      "description": "Global settings for promotions and mapping academic batches to active years"
    },
    "subjects/{subjectCode}": {
      "schema": "Subject",
      "description": "Centralized database subjects"
    },
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "Centralized resources collection mapped by subjectCode"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global platforms updates and admin-published notifications"
    },
    "events/{eventId}/liveRoom/activeQuestion": {
      "schema": "ActiveQuestion",
      "description": "Active real-time question for live event room"
    },
    "events/{eventId}/liveAnswers/{answerId}": {
      "schema": "LiveAnswer",
      "description": "Participant live responses to active questions"
    }
  }
}
