{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator of the platform",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Normalized subject-centric database record serving multiple departments",
      "type": "object",
      "properties": {
        "subjectCode": { "type": "string" },
        "subjectName": { "type": "string" },
        "semester": { "type": "number" },
        "linked_departments": { "type": "array" },
        "credits": { "type": "number" },
        "type": { "type": "string" },
        "lecture": { "type": "number" },
        "tutorial": { "type": "number" },
        "practical": { "type": "number" },
        "outcomes": { "type": "array" },
        "units": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectCode", "subjectName", "semester", "linked_departments"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Academic resource (notes or PYQs) referenced by subject code relation",
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "sem": { "type": "number" },
        "subjectCode": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "fileUrl": { "type": "string" },
        "driveLink": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" },
        "unit": { "type": "number" },
        "year": { "type": "number" },
        "department_visibility": { "type": "array" },
        "semester": { "type": "number" }
      },
      "required": ["subjectCode", "type", "title", "uploadedAt", "uploadedBy"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Global announcement displayed prominently to users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "imageUrl": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonUrl": { "type": "string" },
        "priority": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "type", "priority", "active", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Student user profile parsed from college email domain and onboarding wizard",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "batch": { "type": "string" },
        "departmentCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "section": { "type": "string" },
        "rollNumber": { "type": "string" },
        "selectedUserType": { "type": "string" },
        "effectiveAcademicYear": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "profileVersion": { "type": "number" },
        "lastOpenedRoute": { "type": "string" }
      },
      "required": ["uid", "email", "batch", "departmentCode", "departmentName", "section", "rollNumber", "selectedUserType", "effectiveAcademicYear", "onboardingCompleted", "profileVersion"]
    },
    "AcademicSettings": {
      "title": "AcademicSettings",
      "description": "Holds admin settings such as batch mapping configuration",
      "type": "object",
      "properties": {
        "batchYearMapping": { "type": "object" }
      },
      "required": ["batchYearMapping"]
    },
    "ActiveQuestion": {
      "title": "ActiveQuestion",
      "description": "Active real-time event question published by admin",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "isActive": { "type": "boolean" },
        "questionId": { "type": "string" }
      },
      "required": ["question", "createdBy", "isActive", "questionId"]
    },
    "LiveAnswer": {
      "title": "LiveAnswer",
      "description": "Participant response to active event question",
      "type": "object",
      "properties": {
        "participantId": { "type": "string" },
        "participantName": { "type": "string" },
        "answer": { "type": "string" },
        "submittedAt": { "type": "string" },
        "questionId": { "type": "string" }
      },
      "required": ["participantId", "participantName", "answer", "questionId"]
    },
    "QuizSession": {
      "title": "QuizSession",
      "description": "Active real-time quiz session state for live activities",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "currentQuestionIndex": { "type": "number" },
        "isRunning": { "type": "boolean" },
        "timerDuration": { "type": "number" },
        "questionStartTime": { "type": "number" }
      },
      "required": ["status", "currentQuestionIndex", "isRunning", "timerDuration"]
    },
    "QuizResponse": {
      "title": "QuizResponse",
      "description": "Participant response mapping for active quiz questions",
      "type": "object",
      "properties": {
        "participantId": { "type": "string" },
        "participantName": { "type": "string" }
      },
      "required": ["participantId", "participantName"]
    },
    "CanonicalLiveSession": {
      "title": "CanonicalLiveSession",
      "description": "Authoritative single source of truth for real-time live event state and activity sequence orchestration",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "hostId": { "type": "string" },
        "status": { "type": "string", "enum": ["idle", "waiting", "active", "paused", "ended"] },
        "currentActivityIndex": { "type": "number" },
        "totalActivities": { "type": "number" },
        "currentActivityId": { "type": "string" },
        "currentActivityType": { "type": "string" },
        "currentActivityTitle": { "type": "string" },
        "stage": { "type": "string", "enum": ["ready", "running", "frozen", "reveal", "leaderboard", "completed"] },
        "stageSequenceNumber": { "type": "number" },
        "activityStartedAt": { "type": "number" },
        "stageStartedAt": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "isFrozen": { "type": "boolean" },
        "isRevealed": { "type": "boolean" },
        "stepIndex": { "type": "number" },
        "totalSteps": { "type": "number" }
      },
      "required": ["eventId", "hostId", "status", "currentActivityIndex", "totalActivities", "stage", "stageSequenceNumber"]
    },
    "Participant": {
      "title": "Participant",
      "description": "Participant profile record inside an event room and waiting room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "name": { "type": "string" },
        "college": { "type": "string" },
        "department": { "type": "string" },
        "year": { "type": "string" },
        "online": { "type": "boolean" },
        "roomType": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "name", "online"]
    },
    "Event": {
      "title": "Event",
      "description": "College interactive event document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "eventCode": { "type": "string" },
        "code": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdBy": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "upcoming", "completed"] },
        "acceptingParticipants": { "type": "boolean" },
        "venue": { "type": "string" },
        "banner": { "type": "string" },
        "eventType": { "type": "string" },
        "roomType": { "type": "string" },
        "participantCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "eventId", "title", "eventCode", "ownerId", "status", "acceptingParticipants"]
    },
    "GenericQuizQuestion": {
      "title": "GenericQuizQuestion",
      "description": "Custom event quiz question item with options and points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionId": { "type": "string" },
        "activityId": { "type": "string" },
        "eventId": { "type": "string" },
        "order": { "type": "number" },
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctOptionIndex": { "type": "number" },
        "timeLimitSec": { "type": "number" },
        "points": { "type": "number" },
        "explanation": { "type": "string" }
      },
      "required": ["id", "order", "text", "options", "correctOptionIndex", "points"]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Participant atomic submission record for a quiz question",
      "type": "object",
      "properties": {
        "participantId": { "type": "string" },
        "participantName": { "type": "string" },
        "participantPhoto": { "type": "string" },
        "questionId": { "type": "string" },
        "selectedOptionIndex": { "type": "number" },
        "isCorrect": { "type": "boolean" },
        "pointsAwarded": { "type": "number" },
        "timeTakenSec": { "type": "number" },
        "submittedAt": { "type": "number" }
      },
      "required": ["participantId", "questionId", "selectedOptionIndex", "isCorrect", "pointsAwarded"]
    }
  },
  "firestore": {
    "events/{eventId}": {
      "schema": "Event",
      "description": "College interactive events"
    },
    "admins/{uid}": {
      "schema": "Admin",
      "description": "Platform administrators"
    },
    "users/{uid}": {
      "schema": "User",
      "description": "Durable college students profile"
    },
    "academic_settings/{settingId}": {
      "schema": "AcademicSettings",
      "description": "Global settings for promotions and mapping academic batches to active years"
    },
    "subjects/{subjectCode}": {
      "schema": "Subject",
      "description": "Centralized database subjects"
    },
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "Centralized resources collection mapped by subjectCode"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global platforms updates and admin-published notifications"
    },
    "events/{eventId}/participants/{participantId}": {
      "schema": "Participant",
      "description": "Registered participants in an event room or waiting room"
    },
    "events/{eventId}/liveRoom/activeQuestion": {
      "schema": "ActiveQuestion",
      "description": "Active real-time question for live event room"
    },
    "events/{eventId}/liveAnswers/{answerId}": {
      "schema": "LiveAnswer",
      "description": "Participant live responses to active questions"
    },
    "events/{eventId}/activities/quiz/session/current": {
      "schema": "QuizSession",
      "description": "Active quiz session broadcast state"
    },
    "events/{eventId}/activities/quiz/responses/{participantId}": {
      "schema": "QuizResponse",
      "description": "Participant submitted quiz responses"
    },
    "events/{eventId}/liveSession/current": {
      "schema": "CanonicalLiveSession",
      "description": "Authoritative canonical live session broadcast state"
    },
    "events/{eventId}/activities/{activityId}/questions/{questionId}": {
      "schema": "GenericQuizQuestion",
      "description": "Ordered questions configured for an activity"
    },
    "events/{eventId}/activities/{activityId}/submissions/{submissionId}": {
      "schema": "QuizSubmission",
      "description": "Participant question submissions"
    },
    "events/{eventId}/activities/{activityId}/responses/{participantId}": {
      "schema": "QuizResponse",
      "description": "Participant response record aggregate"
    },
    "events/{eventId}/activities/{activityId}/leaderboard/{participantId}": {
      "schema": "QuizLeaderboardEntry",
      "description": "Participant standings entry"
    }
  }
}
